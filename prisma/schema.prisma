// BECS Analytics LIMS — Prisma schema
// Phase 0 (Foundation): facilities/sections, users & the authorization chain,
// and the cross-cutting subsystems (audit log, attachments, approvals,
// signatures, numbering, notifications). Module-specific models (samples,
// procurement, equipment, finance) are added in their respective phases.
//
// Conventions (SSOT §15): PascalCase models; UUID PKs; every scoped record
// carries facilityId/sectionId; monetary values (later modules) are BigInt paisa.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext, pgcrypto]
}

// ----------------------------------------------------------------------------
// Enums
// ----------------------------------------------------------------------------

enum FacilityCode {
  LAHORE // Parent Lab
  RYK    // Rahimyar Khan on-site QC Sub-Lab
}

enum SectionType {
  LAHORE_LAB
  RYK_LAB
  MANAGEMENT
}

enum Designation {
  COO
  OPERATIONS_MANAGER
  LAB_MANAGER_RYK
  ANALYST
  LAB_ASSISTANT
  LAB_ATTENDANT
  LIAISON_OFFICER
  ACCOUNTANT
  PURCHASE_OFFICER
  STORE_INCHARGE
  IT_OFFICER
  SALES_MARKETING_OFFICER
}

// Lifecycle of a person/account through the split-entry onboarding (Module 01).
enum UserStatus {
  PENDING_PROFILE  // OM created shell; user must complete details
  PENDING_APPROVAL // user submitted; awaiting COO approval
  ACTIVE
  NON_ACTIVE       // resigned (BR-12: retained, never hard-deleted)
}

enum AuthorizationStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  APPROVE
  REJECT
  SIGN
  DECODE
  LOGIN
}

enum AttendanceStatus {
  PRESENT
  ON_LEAVE
  HOLIDAY
}

enum LeaveType {
  ANNUAL
  CASUAL
  SICK
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SampleStatus {
  REGISTERED
  ASSIGNED
  RESULTS_ENTERED
  VERIFIED
  APPROVED
  REPORTED
}

enum MethodType {
  ADOPTED
  LAB_DEVELOPED
}

enum ItemCategory {
  CHEMICAL
  CRM // Certified Reference Material (full path; tracked in Equipment & Traceability)
  EQUIPMENT
  EQUIPMENT_SUPPLY
  GLASSWARE
  LAB_SUPPLY
  STATIONERY
  SANITARY
  FURNITURE
  PPE
  UTILITY
}

enum ProcurementPath {
  FULL // requires quotations + comparative (BR-9)
  SIMPLIFIED // PO-only after COO approval
}

enum PRStatus {
  SUBMITTED
  VERIFIED
  APPROVED
  ORDERED
  REJECTED
}

enum POStatus {
  ISSUED
  RECEIVED
  CANCELLED
}

enum StoreType {
  MAIN
  SUB
}

enum ReceiptStatus {
  PENDING_INSPECTION
  ACCEPTED
  REJECTED
}

enum IssueStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EquipmentStatus {
  ACTIVE
  UNDER_REPAIR
  RETIRED
}

enum QualificationType {
  IQ
  OQ
  PQ
}

enum QualificationResult {
  PASS
  FAIL
}

// ----------------------------------------------------------------------------
// Facilities & sections (SSOT §4, §7)
// ----------------------------------------------------------------------------

model Facility {
  id        String       @id @default(uuid())
  code      FacilityCode @unique
  name      String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  sections Section[]
  users    User[]
}

model Section {
  id         String      @id @default(uuid())
  type       SectionType @unique
  name       String
  facilityId String
  facility   Facility    @relation(fields: [facilityId], references: [id])
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  users User[]

  @@index([facilityId])
}

// ----------------------------------------------------------------------------
// Users, profiles & RBAC (Tier 1)  —  SSOT §6
// ----------------------------------------------------------------------------

model User {
  id           String      @id @default(uuid())
  email        String      @unique
  passwordHash String? // null until account is activated (Argon2id)
  status       UserStatus  @default(PENDING_PROFILE)
  designation  Designation
  facilityId   String
  sectionId    String
  facility     Facility    @relation(fields: [facilityId], references: [id])
  section      Section     @relation(fields: [sectionId], references: [id])

  // org hierarchy (reports-to)
  managerId String?
  manager   User?   @relation("UserManager", fields: [managerId], references: [id])
  reports   User[]  @relation("UserManager")

  profile        PersonnelProfile?
  roles          UserRole[]
  competences    CompetenceEvaluation[] @relation("Subject")
  evaluated      CompetenceEvaluation[] @relation("Evaluator")
  authorizations Authorization[]        @relation("AuthSubject")
  grantedAuths   Authorization[]        @relation("AuthGrantedBy")
  auditLogs      AuditLog[]
  approvals      ApprovalStep[]
  signatures     Signature[]
  notifications  Notification[]
  attendances       Attendance[]
  leaveApplications LeaveApplication[] @relation("LeaveApplicant")
  leaveDecisions    LeaveApplication[] @relation("LeaveApprover")
  undertaking       ImpartialityUndertaking?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([facilityId])
  @@index([sectionId])
  @@index([managerId])
}

// Full HR profile (Module 01). OM enters the shell fields on User; the user
// completes the rest here; COO approval flips User.status to ACTIVE.
model PersonnelProfile {
  id                    String    @id @default(uuid())
  userId                String    @unique
  user                  User      @relation(fields: [userId], references: [id])
  title                 String?
  fullName              String
  fatherName            String?
  dateOfBirth           DateTime?
  cnic                  String?   @unique
  contactNumber         String?
  bloodGroup            String?
  emergencyContact      String?
  education             String?
  experience            String?
  publications          String?
  trainings             String?
  skills                String?
  dateOfJoining         DateTime?
  completedByUserAt     DateTime?
  approvedByCooAt       DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  permissions RolePermission[]
  users       UserRole[]
  createdAt   DateTime         @default(now())
}

model Permission {
  id          String           @id @default(uuid())
  key         String           @unique // e.g. "vendor.register", "client.read"
  description String?
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
}

// ----------------------------------------------------------------------------
// Authorization chain (Tier 2): Function -> Competence -> Authorization
// SSOT §6
// ----------------------------------------------------------------------------

model Function {
  id          String   @id @default(uuid())
  code        String   @unique // e.g. "RUN_TM_014", "SIGN_FINAL_REPORT"
  name        String
  description String?
  createdAt   DateTime @default(now())
  approvedAt  DateTime? // COO approval to make the Function available

  competences    CompetenceEvaluation[]
  authorizations Authorization[]
}

model CompetenceEvaluation {
  id          String   @id @default(uuid())
  subjectId   String
  subject     User     @relation("Subject", fields: [subjectId], references: [id])
  functionId  String
  function    Function @relation(fields: [functionId], references: [id])
  evaluatorId String
  evaluator   User     @relation("Evaluator", fields: [evaluatorId], references: [id])
  result      String // pass/score/notes
  evaluatedAt DateTime @default(now())
  validUntil  DateTime?

  @@index([subjectId])
  @@index([functionId])
}

model Authorization {
  id           String              @id @default(uuid())
  subjectId    String
  subject      User                @relation("AuthSubject", fields: [subjectId], references: [id])
  functionId   String
  function     Function            @relation(fields: [functionId], references: [id])
  grantedById  String // COO
  grantedBy    User                @relation("AuthGrantedBy", fields: [grantedById], references: [id])
  status       AuthorizationStatus @default(ACTIVE)
  effectiveAt  DateTime            @default(now())
  expiresAt    DateTime?
  createdAt    DateTime            @default(now())

  @@unique([subjectId, functionId])
  @@index([functionId])
}

// ----------------------------------------------------------------------------
// Cross-cutting subsystems
// ----------------------------------------------------------------------------

// Immutable audit log (BR-5). Append-only; no update/delete in app code.
model AuditLog {
  id         String      @id @default(uuid())
  actorId    String?
  actor      User?       @relation(fields: [actorId], references: [id])
  action     AuditAction
  entityType String
  entityId   String
  before     Json?
  after      Json?
  facilityId String?
  sectionId  String?
  createdAt  DateTime    @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
}

// Polymorphic attachments (CoA, MSDS, cal certs, quotations, raw-data photos,
// sealed reports). Versioned + controlled-doc status.
model Attachment {
  id           String   @id @default(uuid())
  ownerType    String // e.g. "AnalysisRawData", "Equipment"
  ownerId      String
  kind         String // e.g. "RAW_DATA_PHOTO", "COA", "MSDS"
  fileName     String
  contentType  String
  storageKey   String // S3/MinIO object key
  sha256       String?
  version      Int      @default(1)
  status       String   @default("DRAFT") // DRAFT | APPROVED | OBSOLETE
  uploadedById String?
  createdAt    DateTime @default(now())

  @@index([ownerType, ownerId])
}

// Generic approval routing (SSOT §10). Attaches to any approvable document.
model Approval {
  id         String         @id @default(uuid())
  subjectType String        // e.g. "PurchaseRequest", "PersonnelProfile"
  subjectId  String
  status     ApprovalStatus @default(PENDING)
  facilityId String?
  sectionId  String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  steps ApprovalStep[]

  @@index([subjectType, subjectId])
}

model ApprovalStep {
  id         String         @id @default(uuid())
  approvalId String
  approval   Approval       @relation(fields: [approvalId], references: [id])
  sequence   Int
  approverId String?
  approver   User?          @relation(fields: [approverId], references: [id])
  role       String? // expected approver role/designation, e.g. "COO"
  status     ApprovalStatus @default(PENDING)
  decidedAt  DateTime?
  comment    String?

  @@index([approvalId])
}

// E-signature / record-integrity (reports, undertakings, attendance).
model Signature {
  id          String   @id @default(uuid())
  signerId    String
  signer      User     @relation(fields: [signerId], references: [id])
  subjectType String
  subjectId   String
  meaning     String // "approved", "verified", "checked-in", "undertaking"
  contentHash String? // hash of the sealed record at signing time
  signedAt    DateTime @default(now())

  @@index([subjectType, subjectId])
}

// Gap-free, facility/section-prefixed counters (SSOT §11). One row per series;
// incremented inside the creating transaction.
model Sequence {
  id      String @id @default(uuid())
  key     String @unique // e.g. "SAMPLE:LHR:2026"
  prefix  String
  year    Int?
  counter Int    @default(0)

  @@index([key])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  kind      String // "APPROVAL_PENDING", "CALIBRATION_DUE", ...
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

// ----------------------------------------------------------------------------
// Personnel: attendance, leave, undertaking (Module 01)
// ----------------------------------------------------------------------------

// Daily attendance — e-signed check-in/check-out (BR-20). One row per user/day;
// status reflects leave/holiday integration.
model Attendance {
  id         String           @id @default(uuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id])
  date       DateTime         @db.Date
  checkIn    DateTime?
  checkOut   DateTime?
  status     AttendanceStatus @default(PRESENT)
  facilityId String
  sectionId  String
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([userId, date])
  @@index([userId])
}

// Leave applications — applications-only, no quota tracking (BR-20).
model LeaveApplication {
  id         String      @id @default(uuid())
  userId     String
  user       User        @relation("LeaveApplicant", fields: [userId], references: [id])
  type       LeaveType
  fromDate   DateTime    @db.Date
  toDate     DateTime    @db.Date
  reason     String?
  status     LeaveStatus @default(PENDING)
  approverId String?
  approver   User?       @relation("LeaveApprover", fields: [approverId], references: [id])
  decidedAt  DateTime?
  facilityId String
  sectionId  String
  createdAt  DateTime    @default(now())

  @@index([userId])
  @@index([status])
}

// Impartiality & Confidentiality undertaking — e-signed once per user.
model ImpartialityUndertaking {
  id       String   @id @default(uuid())
  userId   String   @unique
  user     User     @relation(fields: [userId], references: [id])
  version  String   @default("v1")
  signedAt DateTime @default(now())
}

// ----------------------------------------------------------------------------
// Samples & Client (Module 03) + Testing master data (Module 04)
// ----------------------------------------------------------------------------

model Client {
  id            String   @id @default(uuid())
  clientNo      String   @unique
  company       String
  address       String?
  contactPerson String?
  contactNumber String?
  email         String?
  sector        String?
  facilityId    String // owning facility (RYK client = Bio Tech Fertilizers)
  createdById   String?
  createdAt     DateTime @default(now())

  samples Sample[]

  @@index([facilityId])
}

// Master parameter (Module 04 owns these; Samples reads them). `accredited`
// drives the List of Accredited Parameters. Price in PKR paisa (SSOT §15).
model Parameter {
  id         String   @id @default(uuid())
  name       String   @unique
  unit       String?
  accredited Boolean  @default(false)
  price      Int? // PKR paisa
  createdAt  DateTime @default(now())

  sampleParameters SampleParameter[]
}

model TestMethod {
  id        String     @id @default(uuid())
  code      String     @unique
  name      String
  type      MethodType @default(ADOPTED)
  createdAt DateTime   @default(now())

  sampleParameters SampleParameter[]
}

// A registered sample. `labId` is the coded identifier seen by analysts/OM
// (blinding, SSOT §8). The clientId link is access-gated in the app layer.
model Sample {
  id              String       @id @default(uuid())
  labId           String       @unique
  clientId        String
  client          Client       @relation(fields: [clientId], references: [id])
  sampleType      String
  clientSampleRef String? // client-supplied sample id (not identity-revealing)
  priority        String?
  instructions    String?
  thirdPartyName  String? // report issued in the name of a third party
  status          SampleStatus @default(REGISTERED)
  facilityId      String
  sectionId       String
  registeredById  String?
  assignedToId    String? // analyst assigned by OM / Lab Manager (RYK)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  parameters SampleParameter[]
  report     FinalReport?

  @@index([clientId])
  @@index([facilityId])
  @@index([sectionId])
  @@index([status])
}

// A test line item on a sample (sample × parameter). Result entry + raw-data
// photo are added in the Testing increment.
model SampleParameter {
  id                  String      @id @default(uuid())
  sampleId            String
  sample              Sample      @relation(fields: [sampleId], references: [id])
  parameterId         String
  parameter           Parameter   @relation(fields: [parameterId], references: [id])
  testMethodId        String?
  testMethod          TestMethod? @relation(fields: [testMethodId], references: [id])
  resultValue         String?
  calculations        String?
  // Result entered on an instrument with lapsed calibration (allowed but
  // flagged, BR-17). The uploaded raw-data photo is the legal raw record.
  outOfCalibration    Boolean     @default(false)
  rawDataAttachmentId String?
  enteredById         String?
  enteredAt           DateTime?
  createdAt           DateTime    @default(now())

  @@index([sampleId])
}

// Final report — created on COO approval. Hash-sealed snapshot + QR (SSOT §11,
// BR-8). Decoded (client identity revealed) for the LO after approval.
model FinalReport {
  id           String    @id @default(uuid())
  reportNo     String    @unique
  sampleId     String    @unique
  sample       Sample    @relation(fields: [sampleId], references: [id])
  contentHash  String
  qrText       String
  approvedById String?
  approvedAt   DateTime  @default(now())
  decodedAt    DateTime?
  createdAt    DateTime  @default(now())
}

// ----------------------------------------------------------------------------
// Inventory & Procurement (Module 02)
// ----------------------------------------------------------------------------

model Vendor {
  id            String   @id @default(uuid())
  vendorNo      String   @unique
  company       String
  address       String?
  contactNumber String?
  ntn           String?
  stn           String?
  employees     Int?
  fields        String[] // categories supplied (Equipment, Chemicals, Calibration, ...)
  accountNumber String?
  createdById   String?
  createdAt     DateTime @default(now())

  quotations     Quotation[]
  purchaseOrders PurchaseOrder[]

  @@index([company])
}

// Purchase Request (SSOT §10): initiator -> verifier (OM @ Lahore / Lab Manager
// @ RYK, D18) -> COO approves. Mixed-path PRs allowed; path is per line (D10/BR-18).
model PurchaseRequest {
  id            String   @id @default(uuid())
  prNo          String   @unique
  requestedById String
  status        PRStatus @default(SUBMITTED)
  note          String?
  facilityId    String
  sectionId     String
  verifiedById  String?
  verifiedAt    DateTime?
  approvedById  String?
  approvedAt    DateTime?
  createdAt     DateTime @default(now())

  lines      PRLine[]
  quotations Quotation[]
  po         PurchaseOrder?

  @@index([facilityId])
  @@index([sectionId])
  @@index([status])
}

// Vendor quotation against a PR (full-path scope). The COO selects one; the PO
// is generated from it (SSOT §10). Amounts in PKR paisa.
model Quotation {
  id          String          @id @default(uuid())
  prId        String
  pr          PurchaseRequest @relation(fields: [prId], references: [id])
  vendorId    String
  vendor      Vendor          @relation(fields: [vendorId], references: [id])
  amount      Int // PKR paisa
  note        String?
  selected    Boolean         @default(false)
  createdById String?
  createdAt   DateTime        @default(now())

  @@index([prId])
}

// Purchase Order — one per PR. Generated from the selected quotation (full) or
// directly after COO approval for simplified-only PRs (BR-9).
model PurchaseOrder {
  id         String          @id @default(uuid())
  poNo       String          @unique
  prId       String          @unique
  pr         PurchaseRequest @relation(fields: [prId], references: [id])
  vendorId   String?
  vendor     Vendor?         @relation(fields: [vendorId], references: [id])
  amount     Int?
  status     POStatus        @default(ISSUED)
  issuedById String?
  createdAt  DateTime        @default(now())

  receipts GoodsReceipt[]
}

// A store: one MAIN (Lahore) + SUB stores. New goods enter the main store via
// GRN, then move to sub-stores via issue requests (BR-10).
model Store {
  id         String    @id @default(uuid())
  name       String
  type       StoreType
  facilityId String
  createdAt  DateTime  @default(now())

  stock StockTransaction[]
  grns  GRN[]
}

// A delivery against a PO. Multiple per PO supports partial receipts (BR-19).
model GoodsReceipt {
  id           String        @id @default(uuid())
  poId         String
  po           PurchaseOrder @relation(fields: [poId], references: [id])
  receivedById String?
  receivedAt   DateTime      @default(now())
  status       ReceiptStatus @default(PENDING_INSPECTION)
  inspectedById String?
  inspectedAt  DateTime?
  note         String?

  grn GRN?

  @@index([poId])
}

// Goods Receiving Note — issued by the Store In-charge after accepted inspection
// (BR-11); credits stock into the main store.
model GRN {
  id             String       @id @default(uuid())
  grnNo          String       @unique
  goodsReceiptId String       @unique
  goodsReceipt   GoodsReceipt @relation(fields: [goodsReceiptId], references: [id])
  storeId        String
  store          Store        @relation(fields: [storeId], references: [id])
  issuedById     String?
  createdAt      DateTime     @default(now())
}

// Stock movement ledger. Balance per (store, description) = sum(quantity).
model StockTransaction {
  id          String   @id @default(uuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id])
  description String
  quantity    Int // + in / - out
  reason      String // GRN | ISSUE_OUT | ISSUE_IN
  refType     String?
  refId       String?
  createdAt   DateTime @default(now())

  @@index([storeId])
}

// ----------------------------------------------------------------------------
// Equipment & Traceability (Module 05)
// ----------------------------------------------------------------------------

model Equipment {
  id         String          @id @default(uuid())
  assetTag   String          @unique
  name       String
  make       String?
  model      String?
  serialNo   String?
  location   String?
  status     EquipmentStatus @default(ACTIVE)
  facilityId String
  sectionId  String
  createdAt  DateTime        @default(now())

  calibrations   CalibrationRecord[]
  qualifications Qualification[]

  @@index([facilityId])
  @@index([sectionId])
}

// Calibration record. validUntil drives the calibration-validity flag consumed
// by Testing (BR-13/BR-17). Reference/calibration certificate stored as an Attachment.
model CalibrationRecord {
  id                      String    @id @default(uuid())
  equipmentId             String
  equipment               Equipment @relation(fields: [equipmentId], references: [id])
  calibratedOn            DateTime
  validUntil              DateTime
  calibratedBy            String? // vendor name or "internal"
  certificateAttachmentId String?
  note                    String?
  createdById             String?
  createdAt               DateTime  @default(now())

  @@index([equipmentId])
}

// Equipment qualification — enforced order IQ -> OQ -> PQ (D14).
model Qualification {
  id          String              @id @default(uuid())
  equipmentId String
  equipment   Equipment           @relation(fields: [equipmentId], references: [id])
  type        QualificationType
  result      QualificationResult
  performedOn DateTime
  note        String?
  createdById String?
  createdAt   DateTime            @default(now())

  @@index([equipmentId])
}

// Request to move stock from the main store to a sub-store (BR-10).
model IssueRequest {
  id            String      @id @default(uuid())
  requestedById String
  fromStoreId   String
  toStoreId     String
  description   String
  quantity      Int
  status        IssueStatus @default(PENDING)
  approvedById  String?
  decidedAt     DateTime?
  facilityId    String
  createdAt     DateTime    @default(now())

  @@index([status])
}

model PRLine {
  id          String          @id @default(uuid())
  prId        String
  pr          PurchaseRequest @relation(fields: [prId], references: [id])
  description String
  category    ItemCategory
  path        ProcurementPath
  quantity    Int             @default(1)
  unit        String?

  @@index([prId])
}
