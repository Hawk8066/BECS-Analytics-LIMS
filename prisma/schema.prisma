// BECS Analytics LIMS — Prisma schema
// Phase 0 (Foundation): facilities/sections, users & the authorization chain,
// and the cross-cutting subsystems (audit log, attachments, approvals,
// signatures, numbering, notifications). Module-specific models (samples,
// procurement, equipment, finance) are added in their respective phases.
//
// Conventions (SSOT §15): PascalCase models; UUID PKs; every scoped record
// carries facilityId/sectionId; monetary values (later modules) are BigInt paisa.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext, pgcrypto]
}

// ----------------------------------------------------------------------------
// Enums
// ----------------------------------------------------------------------------

enum FacilityCode {
  LAHORE // Parent Lab
  RYK    // Rahimyar Khan on-site QC Sub-Lab
}

enum SectionType {
  LAHORE_LAB
  RYK_LAB
  MANAGEMENT
}

enum Designation {
  ADMIN // application super-admin: full view/edit/delete across all modules + audit
  CLIENT // external client portal login (see own details/samples/reports only)
  VENDOR // external vendor portal login (see own POs/quotations only)
  OUTSOURCE_LAB // external lab portal login (enter results for parameters outsourced to them)
  COO
  OPERATIONS_MANAGER
  LAB_MANAGER_RYK
  ANALYST
  LAB_ASSISTANT
  LAB_ATTENDANT
  LIAISON_OFFICER
  ACCOUNTANT
  PURCHASE_OFFICER
  STORE_INCHARGE
  IT_OFFICER
  SALES_MARKETING_OFFICER
}

// Lifecycle of a person/account through the split-entry onboarding (Module 01).
enum UserStatus {
  PENDING_PROFILE  // OM created shell; user must complete details
  PENDING_APPROVAL // user submitted; awaiting COO approval
  ACTIVE
  NON_ACTIVE       // resigned (BR-12: retained, never hard-deleted)
}

enum AuthorizationStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  APPROVE
  REJECT
  SIGN
  DECODE
  LOGIN
}

enum AttendanceStatus {
  PRESENT
  ON_LEAVE
  HOLIDAY
}

enum LeaveType {
  ANNUAL
  CASUAL
  SICK
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SampleStatus {
  REGISTERED
  ASSIGNED
  RESULTS_ENTERED
  VERIFIED
  APPROVED
  REPORTED
}

enum MethodType {
  ADOPTED
  LAB_DEVELOPED
}

enum ItemCategory {
  CHEMICAL
  CRM // Certified Reference Material (full path; tracked in Equipment & Traceability)
  EQUIPMENT
  EQUIPMENT_SUPPLY
  GLASSWARE
  LAB_SUPPLY
  STATIONERY
  SANITARY
  FURNITURE
  PPE
  UTILITY
}

enum ProcurementPath {
  FULL // requires quotations + comparative (BR-9)
  SIMPLIFIED // PO-only after COO approval
}

enum PRStatus {
  SUBMITTED
  VERIFIED
  APPROVED
  ORDERED
  REJECTED
}

enum POStatus {
  ISSUED
  RECEIVED
  CANCELLED
}

enum StoreType {
  MAIN
  SUB
}

enum ReceiptStatus {
  PENDING_INSPECTION
  ACCEPTED
  REJECTED
}

enum IssueStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EquipmentStatus {
  ACTIVE
  UNDER_REPAIR
  RETIRED
}

enum QualificationType {
  IQ
  OQ
  PQ
}

enum QualificationResult {
  PASS
  FAIL
}

enum MaterialType {
  CHEMICAL
  CRM // Certified Reference Material
  GLASSWARE
  LAB_SUPPLY
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum InvoiceStatus {
  ISSUED
  PARTIAL
  PAID
}

enum PayrollStatus {
  DRAFT
  APPROVED
}

// ----------------------------------------------------------------------------
// Facilities & sections (SSOT §4, §7)
// ----------------------------------------------------------------------------

model Facility {
  id        String       @id @default(uuid())
  code      FacilityCode @unique
  name      String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  sections Section[]
  users    User[]
}

model Section {
  id         String      @id @default(uuid())
  type       SectionType @unique
  name       String
  facilityId String
  facility   Facility    @relation(fields: [facilityId], references: [id])
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  users User[]

  @@index([facilityId])
}

// ----------------------------------------------------------------------------
// Users, profiles & RBAC (Tier 1)  —  SSOT §6
// ----------------------------------------------------------------------------

model User {
  id           String      @id @default(uuid())
  email        String      @unique
  passwordHash String? // null until account is activated (Argon2id)
  status       UserStatus  @default(PENDING_PROFILE)
  designation  Designation
  facilityId   String
  sectionId    String
  facility     Facility    @relation(fields: [facilityId], references: [id])
  section      Section     @relation(fields: [sectionId], references: [id])

  // org hierarchy (reports-to)
  managerId String?
  manager   User?   @relation("UserManager", fields: [managerId], references: [id])
  reports   User[]  @relation("UserManager")

  // External portal logins: link this account to a Client / Vendor / Outsource lab.
  clientId String?
  client   Client? @relation("ClientPortalUser", fields: [clientId], references: [id])
  vendorId String?
  vendor   Vendor? @relation("VendorPortalUser", fields: [vendorId], references: [id])
  outsourceLabId String?
  outsourceLab   OutsourceLab? @relation("OutsourceLabRep", fields: [outsourceLabId], references: [id])

  profile        PersonnelProfile?
  roles          UserRole[]
  competences    CompetenceEvaluation[] @relation("Subject")
  evaluated      CompetenceEvaluation[] @relation("Evaluator")
  authorizations Authorization[]        @relation("AuthSubject")
  grantedAuths   Authorization[]        @relation("AuthGrantedBy")
  auditLogs      AuditLog[]
  approvals      ApprovalStep[]
  signatures     Signature[]
  notifications  Notification[]
  attendances       Attendance[]
  leaveApplications LeaveApplication[] @relation("LeaveApplicant")
  leaveDecisions    LeaveApplication[] @relation("LeaveApprover")
  undertakings      ImpartialityUndertaking[]
  qcLotsAssigned    QcLot[]            @relation("QcLotAnalyst")
  priceChanges      ParameterPriceHistory[]
  pkgPriceChanges   PackagePriceHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([facilityId])
  @@index([sectionId])
  @@index([managerId])
  @@index([clientId])
  @@index([vendorId])
  @@index([outsourceLabId])
}

// Full HR profile (Module 01). OM enters the shell fields on User; the user
// completes the rest here; COO approval flips User.status to ACTIVE.
model PersonnelProfile {
  id                    String    @id @default(uuid())
  userId                String    @unique
  user                  User      @relation(fields: [userId], references: [id])
  title                 String?
  fullName              String
  fatherName            String?
  dateOfBirth           DateTime?
  cnic                  String?   @unique
  contactNumber         String?
  bloodGroup            String?
  emergencyContact      String? // emergency contact number
  emergencyContactName  String?
  emergencyContactRelation String?
  education             String?
  experience            String?
  publications          String?
  trainings             String?
  skills                String?
  dateOfJoining         DateTime?
  completedByUserAt     DateTime?
  approvedByCooAt       DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  educationEntries   EducationEntry[]
  experienceEntries  ExperienceEntry[]
  trainingEntries    TrainingEntry[]
  publicationEntries PublicationEntry[]
}

// Structured education history (multiple per person). Replaces the free-text
// `education` field above for new data entry.
model EducationEntry {
  id          String           @id @default(uuid())
  profileId   String
  profile     PersonnelProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  degreeLevel String // e.g. "Bachelor's", "Master's", "PhD"
  subjects    String?
  startYear   Int?
  endYear     Int?
  createdAt   DateTime         @default(now())

  @@index([profileId])
}

// Structured work experience (multiple per person).
model ExperienceEntry {
  id          String           @id @default(uuid())
  profileId   String
  profile     PersonnelProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  company     String
  designation String?
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime         @default(now())

  @@index([profileId])
}

// Structured training history (multiple per person).
model TrainingEntry {
  id        String           @id @default(uuid())
  profileId String
  profile   PersonnelProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title     String
  year      Int?
  createdAt DateTime         @default(now())

  @@index([profileId])
}

// Structured publications list (multiple per person).
model PublicationEntry {
  id           String           @id @default(uuid())
  profileId    String
  profile      PersonnelProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title        String
  journal      String?
  year         Int?
  impactFactor Float?
  createdAt    DateTime         @default(now())

  @@index([profileId])
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  permissions RolePermission[]
  users       UserRole[]
  createdAt   DateTime         @default(now())
}

model Permission {
  id          String           @id @default(uuid())
  key         String           @unique // e.g. "vendor.register", "client.read"
  description String?
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
}

// ----------------------------------------------------------------------------
// Authorization chain (Tier 2): Function -> Competence -> Authorization
// SSOT §6
// ----------------------------------------------------------------------------

model Function {
  id          String   @id @default(uuid())
  code        String   @unique // e.g. "RUN_TM_014", "SIGN_FINAL_REPORT"
  name        String
  description String?
  // Eligibility criteria for competence/authorization to this function.
  requiredEducation  String[] // acceptable degree levels (any-of)
  requiredFields     String[] // acceptable disciplines (any-of)
  requiredTrainings  String[] // required trainings (free text, multiple)
  minExperienceYears Float? // minimum years of experience (0.5 increments)
  createdAt   DateTime @default(now())
  approvedAt  DateTime? // COO approval to make the Function available

  competences    CompetenceEvaluation[]
  authorizations Authorization[]
}

model CompetenceEvaluation {
  id          String   @id @default(uuid())
  subjectId   String
  subject     User     @relation("Subject", fields: [subjectId], references: [id])
  functionId  String
  function    Function @relation(fields: [functionId], references: [id])
  evaluatorId String
  evaluator   User     @relation("Evaluator", fields: [evaluatorId], references: [id])
  // Outcome of the assessment. `competent` is the gate decision; the basis
  // (education/experience/training/skills) and remarks document how it was reached.
  competent   Boolean  @default(true)
  education   String?
  experience  String?
  training    String?
  skills      String?
  remarks     String?
  result      String? // legacy free-text result/score (kept for older records)
  evaluatedAt DateTime @default(now())
  validUntil  DateTime?

  @@index([subjectId])
  @@index([functionId])
}

model Authorization {
  id           String              @id @default(uuid())
  subjectId    String
  subject      User                @relation("AuthSubject", fields: [subjectId], references: [id])
  functionId   String
  function     Function            @relation(fields: [functionId], references: [id])
  grantedById  String // COO
  grantedBy    User                @relation("AuthGrantedBy", fields: [grantedById], references: [id])
  status       AuthorizationStatus @default(ACTIVE)
  scope        String              @default("FULL") // FULL | PARTIAL (fully/partially authorized)
  effectiveAt  DateTime            @default(now())
  expiresAt    DateTime?
  createdAt    DateTime            @default(now())

  @@unique([subjectId, functionId])
  @@index([functionId])
}

// ----------------------------------------------------------------------------
// Cross-cutting subsystems
// ----------------------------------------------------------------------------

// Immutable audit log (BR-5). Append-only; no update/delete in app code.
model AuditLog {
  id         String      @id @default(uuid())
  actorId    String?
  actor      User?       @relation(fields: [actorId], references: [id])
  action     AuditAction
  entityType String
  entityId   String
  before     Json?
  after      Json?
  facilityId String?
  sectionId  String?
  createdAt  DateTime    @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
}

// Polymorphic attachments (CoA, MSDS, cal certs, quotations, raw-data photos,
// sealed reports). Versioned + controlled-doc status.
model Attachment {
  id           String   @id @default(uuid())
  ownerType    String // e.g. "AnalysisRawData", "Equipment"
  ownerId      String
  kind         String // e.g. "RAW_DATA_PHOTO", "COA", "MSDS"
  fileName     String
  contentType  String
  storageKey   String // S3/MinIO object key
  sha256       String?
  version      Int      @default(1)
  status       String   @default("DRAFT") // DRAFT | APPROVED | OBSOLETE
  uploadedById String?
  createdAt    DateTime @default(now())

  @@index([ownerType, ownerId])
}

// Generic approval routing (SSOT §10). Attaches to any approvable document.
model Approval {
  id         String         @id @default(uuid())
  subjectType String        // e.g. "PurchaseRequest", "PersonnelProfile"
  subjectId  String
  status     ApprovalStatus @default(PENDING)
  facilityId String?
  sectionId  String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  steps ApprovalStep[]

  @@index([subjectType, subjectId])
}

model ApprovalStep {
  id         String         @id @default(uuid())
  approvalId String
  approval   Approval       @relation(fields: [approvalId], references: [id])
  sequence   Int
  approverId String?
  approver   User?          @relation(fields: [approverId], references: [id])
  role       String? // expected approver role/designation, e.g. "COO"
  status     ApprovalStatus @default(PENDING)
  decidedAt  DateTime?
  comment    String?

  @@index([approvalId])
}

// E-signature / record-integrity (reports, undertakings, attendance).
model Signature {
  id          String   @id @default(uuid())
  signerId    String
  signer      User     @relation(fields: [signerId], references: [id])
  subjectType String
  subjectId   String
  meaning     String // "approved", "verified", "checked-in", "undertaking"
  contentHash String? // hash of the sealed record at signing time
  signedAt    DateTime @default(now())

  @@index([subjectType, subjectId])
}

// Gap-free, facility/section-prefixed counters (SSOT §11). One row per series;
// incremented inside the creating transaction.
model Sequence {
  id      String @id @default(uuid())
  key     String @unique // e.g. "SAMPLE:LHR:2026"
  prefix  String
  year    Int?
  counter Int    @default(0)

  @@index([key])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  kind      String // "APPROVAL_PENDING", "CALIBRATION_DUE", ...
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

// ----------------------------------------------------------------------------
// Personnel: attendance, leave, undertaking (Module 01)
// ----------------------------------------------------------------------------

// Daily attendance — e-signed check-in/check-out (BR-20). One row per user/day;
// status reflects leave/holiday integration.
model Attendance {
  id         String           @id @default(uuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id])
  date       DateTime         @db.Date
  checkIn    DateTime?
  checkOut   DateTime?
  status     AttendanceStatus @default(PRESENT)
  facilityId String
  sectionId  String
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([userId, date])
  @@index([userId])
}

// Leave applications — applications-only, no quota tracking (BR-20).
model LeaveApplication {
  id         String      @id @default(uuid())
  userId     String
  user       User        @relation("LeaveApplicant", fields: [userId], references: [id])
  type       LeaveType
  fromDate   DateTime    @db.Date
  toDate     DateTime    @db.Date
  reason     String?
  status     LeaveStatus @default(PENDING)
  approverId String?
  approver   User?       @relation("LeaveApprover", fields: [approverId], references: [id])
  decidedAt  DateTime?
  facilityId String
  sectionId  String
  createdAt  DateTime    @default(now())

  @@index([userId])
  @@index([status])
}

// Impartiality & Confidentiality undertaking — e-signed on first login and then
// re-signed every calendar year (one record per user per year; BR-20 / ISO 17025).
model ImpartialityUndertaking {
  id       String   @id @default(uuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id])
  year     Int
  version  String   @default("2025")
  signedAt DateTime @default(now())

  @@unique([userId, year])
  @@index([userId])
}

// ----------------------------------------------------------------------------
// Samples & Client (Module 03) + Testing master data (Module 04)
// ----------------------------------------------------------------------------

model Client {
  id            String   @id @default(uuid())
  clientNo      String   @unique
  company       String
  address       String? // legacy single-line address (superseded by the fields below)
  addressLine1  String?
  addressLine2  String?
  addressLine3  String?
  city          String?
  province      String?
  country       String?
  contactPerson String?
  contactNumber String?
  email         String?
  sector        String?
  ntn           String? // National Tax Number
  stn           String? // Sales Tax Number
  facilityId    String // owning facility (RYK client = Bio Tech Fertilizers)
  createdById   String?
  createdAt     DateTime @default(now())

  samples  Sample[]
  invoices Invoice[]
  portalUsers User[] @relation("ClientPortalUser")
  testQuotations TestQuotation[]

  @@index([facilityId])
}

// External laboratory that runs subcontracted (outsourced) tests. Registered
// like a Client/Vendor with a portal login: its representative signs in to
// enter results for the parameters outsourced to it (blinded — sees the coded
// Lab ID + parameter only, never the client).
model OutsourceLab {
  id            String   @id @default(uuid())
  labNo         String   @unique
  name          String
  addressLine1  String?
  addressLine2  String?
  addressLine3  String?
  city          String?
  province      String?
  country       String?
  contactPerson String? // focal person
  contactNumber String?
  email         String? // representative portal login
  facilityId    String // owning facility
  createdById   String?
  createdAt     DateTime @default(now())

  portalUsers      User[]            @relation("OutsourceLabRep")
  sampleParameters SampleParameter[]
  labPrices        OutsourceLabPrice[]
  bills            OutsourceBill[]

  @@index([facilityId])
}

// Client-facing quotation for testing services (priced from sector prices &
// packages). Items are snapshotted so the quote is immutable once created.
model TestQuotation {
  id          String              @id @default(uuid())
  quoteNo     String              @unique
  clientId    String
  client      Client              @relation(fields: [clientId], references: [id])
  sector      String?
  // What is being quoted and how many samples of it; the total is the per-sample
  // cost times the quantity.
  sampleType  String?
  sampleQty   Int                 @default(1)
  // Which rate card the quote was priced from (SSOT: samples carry the same).
  priority    PricePriority       @default(NORMAL)
  // Services sales tax, whole percent, added on top of the net; `total` is the
  // tax-inclusive amount.
  taxPct      Int                 @default(0)
  status      String              @default("DRAFT") // DRAFT | SENT | ACCEPTED | REJECTED
  validUntil  DateTime?
  subtotal    Int                 @default(0) // PKR paisa — gross, sum of items
  // Quote-level discount. Kind NONE | PERCENT | AMOUNT; value is a whole percent
  // for PERCENT and paisa for AMOUNT. `total` is the net payable (subtotal less
  // the discount) snapshotted at creation, so the quote stays immutable.
  discountKind  String            @default("NONE")
  discountValue Int               @default(0)
  total         Int               @default(0) // PKR paisa — net payable
  note        String?
  createdById String?
  createdAt   DateTime            @default(now())

  items    TestQuotationItem[]
  samples  Sample[]
  invoices Invoice[]

  @@index([clientId])
}

model TestQuotationItem {
  id          String        @id @default(uuid())
  quotationId String
  quotation   TestQuotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  kind        String // PARAMETER | PACKAGE
  refId       String?
  name        String
  price       Int // PKR paisa — before discount
  discount    Int  @default(0) // PKR paisa — per-line discount

  @@index([quotationId])
}

// Master parameter (Module 04 owns these; Samples reads them). `accredited`
// drives the List of Accredited Parameters. Price in PKR paisa (SSOT §15).
model Parameter {
  id          String    @id @default(uuid())
  name        String
  unit        String?
  matrix      String? // sample matrix (e.g. Soil, Water, Fertilizer)
  method      String? // test method / reference
  lod         String? // Limit of Detection
  loq         String? // Limit of Quantification
  accredited  Boolean   @default(false)
  price       Int? // PKR paisa — normal priority
  urgentPrice Int? // PKR paisa — urgent priority (falls back to price when unset)
  // Turnaround time in working days, per priority. What the client is promised.
  tatDays       Int?
  tatUrgentDays Int?
  createdById String? // proposer (OM / LO / Lab Manager)
  approvedAt  DateTime? // COO approval to make the parameter available
  createdAt   DateTime  @default(now())

  sampleParameters   SampleParameter[]
  sectorPrices       ParameterSectorPrice[]
  outsourceLabPrices OutsourceLabPrice[]
  priceHistory       ParameterPriceHistory[]
  packageLinks       PackageParameter[]
  standardLimits     StandardLimit[]

  // A parameter is unique per (name, matrix) — the same test can exist for
  // different matrices with its own method/unit.
  @@unique([name, matrix])
}

// A published standard/specification a client can have a sample conformed
// against. Same product can be conformed on different standards, so each is a
// named set of per-parameter acceptance limits.
model Standard {
  id          String   @id @default(uuid())
  name        String   @unique
  matrix      String? // filing label (e.g. Fertilizer - Solid)
  description String?
  createdById String?
  createdAt   DateTime @default(now())

  limits  StandardLimit[]
  samples Sample[]
}

// One parameter's acceptance limit within a standard. Nullable min/max encode
// the kind: max only = "≤", min only = "≥", both = "between", neither = none.
model StandardLimit {
  id          String    @id @default(uuid())
  standardId  String
  standard    Standard  @relation(fields: [standardId], references: [id], onDelete: Cascade)
  parameterId String
  parameter   Parameter @relation(fields: [parameterId], references: [id])
  min         Float? // ≥ bound (greater-than / between lower)
  max         Float? // ≤ bound (less-than / between upper)
  unit        String? // display unit (defaults to the parameter's)

  @@unique([standardId, parameterId])
  @@index([parameterId])
}

// Per-sector price for a parameter (PKR paisa). Pricing is sector-based, and
// each sector carries a normal and an urgent rate; the row exists while either
// is set. An unset urgent price means urgent work is charged the normal rate.
model ParameterSectorPrice {
  id          String    @id @default(uuid())
  parameterId String
  parameter   Parameter @relation(fields: [parameterId], references: [id], onDelete: Cascade)
  sector      String
  price       Int? // paisa — normal priority
  urgentPrice Int? // paisa — urgent priority
  updatedAt   DateTime  @updatedAt

  @@unique([parameterId, sector])
  @@index([parameterId])
}

// Prices (and turnaround times) come in two grades: standard work and rush work.
enum PricePriority {
  NORMAL
  URGENT
}

// How a price came to be set — a manual entry and an uploaded workbook are
// traced differently when a figure is later questioned.
enum PriceChangeSource {
  MANUAL // typed into the Prices tab
  IMPORT // arrived on an uploaded workbook
  BACKFILL // recorded after the fact, for prices set before this log existed
  CORRECTION // put right by a maintenance script; no operator on record
}

// Dated trail of every parameter price change, so a price can always be traced
// to the day it was set and to whoever set it. Append-only, like AuditLog: the
// current price lives on ParameterSectorPrice, the story of it lives here.
model ParameterPriceHistory {
  id          String            @id @default(uuid())
  parameterId String
  parameter   Parameter         @relation(fields: [parameterId], references: [id], onDelete: Cascade)
  // Legacy: pricing was once per-sector. Now null — a parameter has one price.
  sector      String?
  priority    PricePriority     @default(NORMAL)
  oldPrice    Int? // paisa; null when the sector had no price before
  price       Int? // paisa; null when the price was cleared
  source      PriceChangeSource @default(MANUAL)
  changedById String?
  changedBy   User?             @relation(fields: [changedById], references: [id])
  changedAt   DateTime          @default(now())

  @@index([parameterId, sector, changedAt])
  @@index([changedAt])
}

// A named bundle of parameters offered as a package; priced per sector.
model Package {
  id          String               @id @default(uuid())
  name        String               @unique
  // The matrix (sample type) this package is filed under, e.g. "Fertilizer -
  // Solid". Optional; a package may span matrices.
  matrix      String?
  // A package is priced as one bundle (not per sector). Normal + urgent grades;
  // urgent falls back to normal +50% when unset, same rule as parameters.
  price       Int? // PKR paisa — normal priority
  urgentPrice Int? // PKR paisa — urgent priority
  createdById String?
  createdAt   DateTime             @default(now())
  parameters  PackageParameter[]
  prices      PackageSectorPrice[] // legacy, no longer used for pricing

  priceHistory PackagePriceHistory[]
}

model PackageParameter {
  packageId   String
  package     Package   @relation(fields: [packageId], references: [id], onDelete: Cascade)
  parameterId String
  parameter   Parameter @relation(fields: [parameterId], references: [id])

  @@id([packageId, parameterId])
  @@index([parameterId])
}

model PackageSectorPrice {
  id          String   @id @default(uuid())
  packageId   String
  package     Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  sector      String
  price       Int? // paisa — normal priority
  urgentPrice Int? // paisa — urgent priority
  updatedAt   DateTime @updatedAt

  @@unique([packageId, sector])
}

// Dated trail of package price changes — the ParameterPriceHistory of packages.
model PackagePriceHistory {
  id          String            @id @default(uuid())
  packageId   String
  package     Package           @relation(fields: [packageId], references: [id], onDelete: Cascade)
  sector      String?
  priority    PricePriority     @default(NORMAL)
  oldPrice    Int? // paisa; null when the sector had no price before
  price       Int? // paisa; null when the price was cleared
  source      PriceChangeSource @default(MANUAL)
  changedById String?
  changedBy   User?             @relation(fields: [changedById], references: [id])
  changedAt   DateTime          @default(now())

  @@index([packageId, sector, changedAt])
  @@index([changedAt])
}

model TestMethod {
  id        String     @id @default(uuid())
  code      String     @unique
  name      String
  type      MethodType @default(ADOPTED)
  createdAt DateTime   @default(now())

  sampleParameters SampleParameter[]
}

// A registered sample. `labId` is the coded identifier seen by analysts/OM
// (blinding, SSOT §8). The clientId link is access-gated in the app layer.
model Sample {
  id              String       @id @default(uuid())
  labId           String       @unique
  clientId        String
  client          Client       @relation(fields: [clientId], references: [id])
  sampleType      String
  clientSampleRef String? // client-supplied sample id (not identity-revealing)
  quantity        String? // received amount as printed on the report, e.g. "800 g"
  physicalCondition String? // e.g. "Solid granules", "Liquid" — shown on the report
  priority        String?
  instructions    String?
  thirdPartyName  String? // report issued in the name of a third party
  status          SampleStatus @default(REGISTERED)
  // The accepted quotation this sample was booked against, when there is one:
  // walk-in samples have none, quoted work is traceable back to what was agreed.
  quotationId     String?
  quotation       TestQuotation? @relation(fields: [quotationId], references: [id])
  // Optional standard the client asked this sample to be conformed against; each
  // result's limit is snapshotted onto its SampleParameter at registration.
  standardId      String?
  standard        Standard?    @relation(fields: [standardId], references: [id])
  facilityId      String
  sectionId       String
  registeredById  String?
  // Deprecated: analyst assignment is now per-parameter (SampleParameter.assignedToId).
  // Kept nullable for historical rows; no longer read by the testing workflow.
  assignedToId    String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  parameters SampleParameter[]
  report     FinalReport?

  @@index([clientId])
  @@index([facilityId])
  @@index([sectionId])
  @@index([status])
  @@index([quotationId])
  @@index([standardId])
}

// A test line item on a sample (sample × parameter). Result entry + raw-data
// photo are added in the Testing increment.
model SampleParameter {
  id                  String      @id @default(uuid())
  sampleId            String
  sample              Sample      @relation(fields: [sampleId], references: [id])
  parameterId         String
  parameter           Parameter   @relation(fields: [parameterId], references: [id])
  unit                String? // unit chosen for this sample (may differ from the parameter default)
  // Analyst assigned to run this specific test — assignment is per-parameter, so
  // one sample's parameters can be split across several analysts (D-testing).
  // Mutually exclusive with outsourceLabId: a parameter is run in-house by an
  // analyst OR subcontracted to an external lab, never both.
  assignedToId        String?
  outsourceLabId      String?
  outsourceLab        OutsourceLab? @relation(fields: [outsourceLabId], references: [id])
  // The payable bill this outsourced test was billed on. Locks the test: it
  // can't be re-billed or reassigned once set.
  outsourceBillId     String?
  outsourceBill       OutsourceBill? @relation(fields: [outsourceBillId], references: [id])
  testMethodId        String?
  testMethod          TestMethod? @relation(fields: [testMethodId], references: [id])
  resultValue         String?
  calculations        String?
  // Conformity: the acceptance limit snapshotted from the sample's standard at
  // registration (nullable min/max = ≥ / ≤ / between / none), and the verdict
  // computed when the result is entered (CONFORM | NON_CONFORM | null).
  limitMin            Float?
  limitMax            Float?
  conformity          String?
  // Result entered on an instrument with lapsed calibration (allowed but
  // flagged, BR-17). The uploaded raw-data photo is the legal raw record.
  outOfCalibration    Boolean     @default(false)
  // Raw-data reference: the physical lab register + page where the result is
  // recorded (in-house analysts). Outsourced results attach a report instead.
  registerNo          String?
  pageNo              String?
  rawDataAttachmentId String?
  enteredById         String?
  enteredAt           DateTime?
  createdAt           DateTime    @default(now())

  @@index([sampleId])
  @@index([assignedToId])
  @@index([outsourceLabId])
  @@index([outsourceBillId])
}

// Final report — created on COO approval. Hash-sealed snapshot + QR (SSOT §11,
// BR-8). Decoded (client identity revealed) for the LO after approval.
model FinalReport {
  id           String    @id @default(uuid())
  reportNo     String    @unique
  sampleId     String    @unique
  sample       Sample    @relation(fields: [sampleId], references: [id])
  contentHash  String
  qrText       String
  approvedById String?
  approvedAt   DateTime  @default(now())
  decodedAt    DateTime?
  createdAt    DateTime  @default(now())
}

// ----------------------------------------------------------------------------
// Inventory & Procurement (Module 02)
// ----------------------------------------------------------------------------

model Vendor {
  id            String   @id @default(uuid())
  vendorNo      String   @unique
  company       String
  address       String?
  contactNumber String?
  ntn           String?
  stn           String?
  email         String? // vendor portal login
  employees     Int?
  fields        String[] // categories supplied (Equipment, Chemicals, Calibration, ...)
  accountNumber String?
  createdById   String?
  createdAt     DateTime @default(now())

  quotations     Quotation[]
  purchaseOrders PurchaseOrder[]
  portalUsers    User[]          @relation("VendorPortalUser")

  @@index([company])
}

// Purchase Request (SSOT §10): initiator -> verifier (OM @ Lahore / Lab Manager
// @ RYK, D18) -> COO approves. Mixed-path PRs allowed; path is per line (D10/BR-18).
model PurchaseRequest {
  id            String   @id @default(uuid())
  prNo          String   @unique
  requestedById String
  status        PRStatus @default(SUBMITTED)
  note          String?
  facilityId    String
  sectionId     String
  verifiedById  String?
  verifiedAt    DateTime?
  approvedById  String?
  approvedAt    DateTime?
  createdAt     DateTime @default(now())

  lines      PRLine[]
  quotations Quotation[]
  pos        PurchaseOrder[]

  @@index([facilityId])
  @@index([sectionId])
  @@index([status])
}

// Vendor quotation against a PR (full-path scope). Rates are captured per PR line
// (QuotationLine) so the Comparative Statement (Form 6-B) can be produced; the COO
// awards a winning vendor per line. `amount` = Σ(rate × qty) over quoted lines;
// `selected` = this vendor won ≥ 1 line. Amounts in PKR paisa (SSOT §10).
model Quotation {
  id          String          @id @default(uuid())
  prId        String
  pr          PurchaseRequest @relation(fields: [prId], references: [id])
  vendorId    String
  vendor      Vendor          @relation(fields: [vendorId], references: [id])
  amount      Int // PKR paisa (Σ line rate × qty)
  note        String?
  selected    Boolean         @default(false)
  createdById String?
  createdAt   DateTime        @default(now())

  lines QuotationLine[]

  @@unique([prId, vendorId])
  @@index([prId])
}

// A vendor's offered specification + unit rate for one PR line — the cells of the
// Comparative Statement (Form 6-B). `selected` marks the winning vendor for that
// line (per-item award; a PR can split across several vendors). Rate in PKR paisa.
model QuotationLine {
  id            String    @id @default(uuid())
  quotationId   String
  quotation     Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  prLineId      String
  prLine        PRLine    @relation(fields: [prLineId], references: [id])
  specification String?
  rate          Int // PKR paisa, per unit
  selected      Boolean   @default(false)
  createdAt     DateTime  @default(now())

  @@unique([quotationId, prLineId])
  @@index([prLineId])
}

// Purchase Order. A comparative can award different lines to different vendors, so
// one PR yields one PO per winning vendor — each PO carries only the lines that
// vendor won (PurchaseOrderLine). Simplified-only PRs generate one direct PO
// covering all lines after COO approval (BR-9).
model PurchaseOrder {
  id         String          @id @default(uuid())
  poNo       String          @unique
  prId       String
  pr         PurchaseRequest @relation(fields: [prId], references: [id])
  vendorId   String?
  vendor     Vendor?         @relation(fields: [vendorId], references: [id])
  amount     Int?
  status     POStatus        @default(ISSUED)
  issuedById String?
  createdAt  DateTime        @default(now())

  lines    PurchaseOrderLine[]
  receipts GoodsReceipt[]

  @@index([prId])
}

// The PR lines a PO covers (snapshot of description/qty/awarded rate) — drives
// GRN stock crediting and payables. Rate is null for simplified direct POs.
model PurchaseOrderLine {
  id          String        @id @default(uuid())
  poId        String
  po          PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  prLineId    String
  prLine      PRLine        @relation(fields: [prLineId], references: [id])
  description String
  quantity    Int
  unit        String?
  rate        Int? // PKR paisa, per unit (null when no per-line rate)

  @@index([poId])
}

// A store: one MAIN (Lahore) + SUB stores. New goods enter the main store via
// GRN, then move to sub-stores via issue requests (BR-10).
model Store {
  id         String    @id @default(uuid())
  name       String
  type       StoreType
  facilityId String
  createdAt  DateTime  @default(now())

  stock StockTransaction[]
  grns  GRN[]
  items InventoryItem[]
}

// User-reported stock level for an inventory item.
enum StockStatus {
  OK
  LOW // running low — needs reordering
  END // finished / out of stock
}

enum InventoryCategory {
  CHEMICAL // lab chemicals register (rack + lot)
  STANDARD_SOLUTION // reference standards / buffer solutions
  GLASSWARE
  EQUIPMENT
  STORE_ITEM // bulk chemicals held in the store
  MISCELLANEOUS // consumables (gloves, filter paper, …)
  STATIONERY
}

// Inventory register for a store — the standing list of chemicals, glassware and
// equipment (imported from the lab's inventory workbook). Distinct from the
// transactional StockTransaction ledger; this is the catalog with locations,
// pack sizes, makes/models and on-hand counts.
model InventoryItem {
  id         String            @id @default(uuid())
  storeId    String
  store      Store             @relation(fields: [storeId], references: [id])
  category   InventoryCategory
  code       String? // item ID / equipment code
  name       String
  pack       String? // chemical pack size (e.g. "500 g")
  rack       String? // storage location (e.g. "R1")
  make       String? // glassware/equipment make
  model      String? // equipment model
  parts      String? // equipment parts/accessories
  subCategory String? // chemical category (Salt/Acid/…)
  quantity   Int? // on-hand balance ("Nill" → 0)
  lotNo      String? // LOT / batch number
  stockStatus     StockStatus @default(OK) // user-reported level (low / finished)
  stockMarkedById String?
  stockMarkedAt   DateTime?
  facilityId String
  createdAt  DateTime          @default(now())

  @@index([storeId])
  @@index([facilityId])
  @@index([category])
}

// A delivery against a PO. Multiple per PO supports partial receipts (BR-19).
model GoodsReceipt {
  id           String        @id @default(uuid())
  poId         String
  po           PurchaseOrder @relation(fields: [poId], references: [id])
  receivedById String?
  receivedAt   DateTime      @default(now())
  status       ReceiptStatus @default(PENDING_INSPECTION)
  inspectedById String?
  inspectedAt  DateTime?
  note         String?

  grn GRN?

  @@index([poId])
}

// Goods Receiving Note — issued by the Store In-charge after accepted inspection
// (BR-11); credits stock into the main store.
model GRN {
  id             String       @id @default(uuid())
  grnNo          String       @unique
  goodsReceiptId String       @unique
  goodsReceipt   GoodsReceipt @relation(fields: [goodsReceiptId], references: [id])
  storeId        String
  store          Store        @relation(fields: [storeId], references: [id])
  issuedById     String?
  createdAt      DateTime     @default(now())
}

// Stock movement ledger. Balance per (store, description) = sum(quantity).
model StockTransaction {
  id          String   @id @default(uuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id])
  description String
  quantity    Int // + in / - out
  reason      String // GRN | ISSUE_OUT | ISSUE_IN
  refType     String?
  refId       String?
  createdAt   DateTime @default(now())

  @@index([storeId])
}

// ----------------------------------------------------------------------------
// Equipment & Traceability (Module 05)
// ----------------------------------------------------------------------------

model Equipment {
  id         String          @id @default(uuid())
  assetTag   String          @unique
  name       String
  make       String?
  model      String?
  serialNo   String?
  location   String?
  status     EquipmentStatus @default(ACTIVE)
  facilityId String
  sectionId  String
  createdAt  DateTime        @default(now())

  calibrations   CalibrationRecord[]
  qualifications Qualification[]

  @@index([facilityId])
  @@index([sectionId])
}

// Calibration record. validUntil drives the calibration-validity flag consumed
// by Testing (BR-13/BR-17). Reference/calibration certificate stored as an Attachment.
model CalibrationRecord {
  id                      String    @id @default(uuid())
  equipmentId             String
  equipment               Equipment @relation(fields: [equipmentId], references: [id])
  calibratedOn            DateTime
  validUntil              DateTime
  calibratedBy            String? // vendor name or "internal"
  certificateAttachmentId String?
  note                    String?
  createdById             String?
  createdAt               DateTime  @default(now())

  @@index([equipmentId])
}

// Consumable / reference materials register (Module 05): chemicals (CoA/MSDS),
// CRM (reference certificate + certified value), glassware (cal certs), lab
// supplies. Certificates are stored as polymorphic Attachments
// (ownerType="MaterialItem"). CRM/chemical lots carry lot + expiry.
model MaterialItem {
  id             String       @id @default(uuid())
  type           MaterialType
  name           String
  lotNo          String?
  certifiedValue String? // CRM
  expiry         DateTime?
  unit           String?
  facilityId     String
  sectionId      String
  createdById    String?
  createdAt      DateTime     @default(now())

  @@index([facilityId])
  @@index([type])
}

// ----------------------------------------------------------------------------
// Finance & Payroll (Module 06) — full double-entry GL (ADR-0004, BR-16)
// ----------------------------------------------------------------------------

model ChartOfAccount {
  id    String      @id @default(uuid())
  code  String      @unique
  name  String
  type  AccountType
  lines JournalLine[]
}

// A balanced journal entry (sum debits = sum credits). Append-only (BR-16);
// corrections via reversing entries. Amounts in PKR paisa.
model JournalEntry {
  id          String       @id @default(uuid())
  entryNo     String       @unique
  date        DateTime     @default(now())
  memo        String?
  createdById String?
  createdAt   DateTime     @default(now())

  lines JournalLine[]
}

model JournalLine {
  id        String         @id @default(uuid())
  entryId   String
  entry     JournalEntry   @relation(fields: [entryId], references: [id])
  accountId String
  account   ChartOfAccount @relation(fields: [accountId], references: [id])
  debit     Int            @default(0) // paisa
  credit    Int            @default(0) // paisa

  @@index([entryId])
  @@index([accountId])
}

model Invoice {
  id             String        @id @default(uuid())
  invoiceNo      String        @unique
  clientId       String
  client         Client        @relation(fields: [clientId], references: [id])
  // The accepted quotation this invoice bills, when raised from one (testing
  // work). Ad-hoc invoices have none.
  quotationId    String?
  quotation      TestQuotation? @relation(fields: [quotationId], references: [id])
  // subtotal is the gross of line prices; amount is the net after per-line
  // discounts and the invoice-level total discount (PERCENT/AMOUNT/NONE).
  subtotal       Int           @default(0) // paisa
  discountKind   String        @default("NONE")
  discountValue  Int           @default(0)
  taxPct         Int           @default(0) // services sales tax, whole percent
  amount         Int // paisa — net payable, tax-inclusive
  status         InvoiceStatus @default(ISSUED)
  memo           String?
  issuedById     String?
  journalEntryId String?
  facilityId     String
  createdAt      DateTime      @default(now())

  items    InvoiceItem[]
  payments Payment[]

  @@index([clientId])
  @@index([facilityId])
  @@index([quotationId])
}

// A billed line on an invoice, snapshotted from the quotation at issue time so
// the invoice is immutable. `discount` is the per-line reduction in paisa.
model InvoiceItem {
  id        String  @id @default(uuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  kind      String // PARAMETER | PACKAGE
  refId     String?
  name      String
  price     Int // paisa — before discount
  discount  Int     @default(0) // paisa — per-line

  @@index([invoiceId])
}

model Payment {
  id             String   @id @default(uuid())
  invoiceId      String
  invoice        Invoice  @relation(fields: [invoiceId], references: [id])
  amount         Int // paisa
  method         String?
  receivedById   String?
  journalEntryId String?
  createdAt      DateTime @default(now())

  @@index([invoiceId])
}

// ----------------------------------------------------------------------------
// Outsource-lab billing (accounts payable): what we owe external labs for the
// tests we subcontract to them. Mirrors the client Invoice/Payment (AR) flow,
// inverted — the lab invoices us and we pay it.
// ----------------------------------------------------------------------------

// A lab's price for one test — what the lab charges us (different from the price
// we charge clients). One row per (lab, parameter).
model OutsourceLabPrice {
  id             String       @id @default(uuid())
  outsourceLabId String
  outsourceLab   OutsourceLab @relation(fields: [outsourceLabId], references: [id], onDelete: Cascade)
  parameterId    String
  parameter      Parameter    @relation(fields: [parameterId], references: [id])
  price          Int? // PKR paisa — the lab's charge per test
  updatedAt      DateTime     @updatedAt

  @@unique([outsourceLabId, parameterId])
  @@index([outsourceLabId])
}

// A payable bill recorded from an outsource lab's invoice. Line items are
// snapshotted so the bill is immutable once created.
model OutsourceBill {
  id             String        @id @default(uuid())
  billNo         String        @unique
  outsourceLabId String
  outsourceLab   OutsourceLab  @relation(fields: [outsourceLabId], references: [id])
  labInvoiceNo   String? // the lab's own invoice number
  subtotal       Int           @default(0) // paisa — net (sum of line prices)
  taxPct         Int           @default(0) // input sales tax, whole percent
  amount         Int // paisa — gross payable (net + tax)
  status         InvoiceStatus @default(ISSUED)
  journalEntryId String?
  facilityId     String
  createdById    String?
  createdAt      DateTime      @default(now())

  items            OutsourceBillItem[]
  payments         OutsourcePayment[]
  billedParameters SampleParameter[]

  @@index([outsourceLabId])
  @@index([facilityId])
}

// A billed test line on an outsource bill (snapshot). `sampleParameterId` is a
// loose reference back to the test that was billed.
model OutsourceBillItem {
  id                String        @id @default(uuid())
  billId            String
  bill              OutsourceBill @relation(fields: [billId], references: [id], onDelete: Cascade)
  sampleParameterId String?
  name              String // parameter name snapshot
  sampleLabId       String // coded Sample.labId snapshot
  price             Int // paisa

  @@index([billId])
}

// A payment made to an outsource lab against a bill.
model OutsourcePayment {
  id             String        @id @default(uuid())
  billId         String
  bill           OutsourceBill @relation(fields: [billId], references: [id])
  amount         Int // paisa
  method         String?
  paidById       String?
  journalEntryId String?
  createdAt      DateTime      @default(now())

  @@index([billId])
}

// Versioned salary structure (one current per user). Amounts in PKR paisa;
// providentFundPct is a whole-number percent of basic.
model SalaryStructure {
  id               String   @id @default(uuid())
  userId           String   @unique
  basic            Int
  houseRent        Int      @default(0)
  conveyance       Int      @default(0)
  medical          Int      @default(0)
  otherAllowances  Int      @default(0)
  providentFundPct Int      @default(0)
  eobi             Int      @default(0)
  effectiveFrom    DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// Monthly payroll run (D4). Posts to the GL on COO approval.
model PayrollRun {
  id             String        @id @default(uuid())
  runNo          String        @unique
  period         String // "2026-06"
  status         PayrollStatus @default(DRAFT)
  facilityId     String
  createdById    String?
  approvedById   String?
  approvedAt     DateTime?
  journalEntryId String?
  createdAt      DateTime      @default(now())

  items PayrollItem[]

  @@index([facilityId])
}

model PayrollItem {
  id            String     @id @default(uuid())
  runId         String
  run           PayrollRun @relation(fields: [runId], references: [id])
  userId        String
  gross         Int
  incomeTax     Int        @default(0)
  providentFund Int        @default(0)
  eobi          Int        @default(0)
  advances      Int        @default(0)
  netPay        Int

  @@index([runId])
}

// Equipment qualification — enforced order IQ -> OQ -> PQ (D14).
model Qualification {
  id          String              @id @default(uuid())
  equipmentId String
  equipment   Equipment           @relation(fields: [equipmentId], references: [id])
  type        QualificationType
  result      QualificationResult
  performedOn DateTime
  note        String?
  createdById String?
  createdAt   DateTime            @default(now())

  @@index([equipmentId])
}

// Request to move stock from the main store to a sub-store (BR-10).
model IssueRequest {
  id            String      @id @default(uuid())
  requestedById String
  fromStoreId   String
  toStoreId     String
  description   String
  quantity      Int
  status        IssueStatus @default(PENDING)
  approvedById  String?
  decidedAt     DateTime?
  facilityId    String
  createdAt     DateTime    @default(now())

  @@index([status])
}

model PRLine {
  id            String          @id @default(uuid())
  prId          String
  pr            PurchaseRequest @relation(fields: [prId], references: [id])
  description   String // "Name of item/services" on the requisition form
  specification String? // technical spec / grade / model
  category      ItemCategory
  path          ProcurementPath
  quantity      Int             @default(1)
  unit          String?
  justification String? // why the item is needed
  priority      String? // Low | Normal | High | Urgent
  selectionNote String? // Comparative award justification (why this vendor for this line)

  quotationLines QuotationLine[]
  poLines        PurchaseOrderLine[]

  @@index([prId])
}

// ── Production QC & traceability (RYK) ────────────────────────────────────────
// Zinc-content testing along a production chain: Raw Zinc (per vehicle) → AOM
// (per batch) → Zabardast Urea (per batch). Each product is sampled and tested
// for a parameter, with results traced upstream through parent lots.

enum ProductStage {
  RAW // raw material (e.g. Raw Zinc)
  INTERMEDIATE // in-process product (e.g. AOM)
  FINISHED // finished product (e.g. Zabardast Urea)
}

enum LotBasis {
  VEHICLE // each incoming vehicle load is a lot
  BATCH // each production batch is a lot
}

enum QcLotStatus {
  BOOKED // sample booked + assigned, awaiting analyst result
  SUBMITTED // analyst submitted result, awaiting Lab Manager review
  APPROVED // result reviewed & approved
  REJECTED // result rejected / sent back
}

// A product/raw-material type with its test parameter, identity basis, spec
// limits, and the parent product it traces to (self-referential lineage).
model ProductType {
  id            String       @id @default(uuid())
  name          String
  stage         ProductStage
  basis         LotBasis
  testParameter String // e.g. "Total Zinc", "Bio-Active Zinc"
  unit          String       @default("%")
  specMin       Float? // acceptable minimum for auto pass/fail
  specMax       Float? // acceptable maximum (optional)
  parentTypeId  String?
  parentType    ProductType?  @relation("ProductLineage", fields: [parentTypeId], references: [id])
  children      ProductType[] @relation("ProductLineage")
  sortOrder     Int          @default(0)
  facilityId    String
  createdAt     DateTime     @default(now())

  lots QcLot[]

  @@unique([facilityId, name])
}

// A physical lot sampled for QC — a vehicle load or a production batch. Carries
// the manual production number (refNo) plus an auto lab number (lotNo), a single
// primary result, and many-to-many parent links for blended traceability.
model QcLot {
  id            String      @id @default(uuid())
  lotNo         String      @unique // auto lab number, e.g. RYK-QC-2026-0001
  productTypeId String
  productType   ProductType @relation(fields: [productTypeId], references: [id])
  refNo         String // manual vehicle/batch number from production
  producedOn    DateTime?
  quantity      Float?
  quantityUnit  String?
  source        String? // supplier/origin for raw materials
  note          String?
  status        QcLotStatus @default(BOOKED)
  resultValue   Float?
  verdict       String? // PASS | FAIL (from spec at test time)
  bookedById    String?
  assignedToId  String? // analyst the Lab Manager assigned the sample to
  assignedTo    User?       @relation("QcLotAnalyst", fields: [assignedToId], references: [id])
  testedById    String? // analyst who submitted the result
  testedAt      DateTime?
  approvedById  String? // Lab Manager who reviewed
  approvedAt    DateTime?
  facilityId    String
  createdAt     DateTime    @default(now())

  parents  QcLotLink[] @relation("LotChild")
  children QcLotLink[] @relation("LotParent")

  @@index([productTypeId])
  @@index([facilityId])
  @@index([status])
  @@index([assignedToId])
}

// Many-to-many lot genealogy: a child lot (e.g. AOM batch) is built from one or
// more parent lots (e.g. raw-zinc vehicles).
model QcLotLink {
  id          String @id @default(uuid())
  childLotId  String
  parentLotId String
  child       QcLot  @relation("LotChild", fields: [childLotId], references: [id], onDelete: Cascade)
  parent      QcLot  @relation("LotParent", fields: [parentLotId], references: [id], onDelete: Cascade)

  @@unique([childLotId, parentLotId])
  @@index([childLotId])
  @@index([parentLotId])
}
