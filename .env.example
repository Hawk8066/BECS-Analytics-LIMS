# BECS Analytics LIMS — environment template. Copy to `.env` and fill in.
# Never commit a real .env (see .gitignore).

# --- Database (Postgres / docker-compose) ---
POSTGRES_USER=becs
POSTGRES_PASSWORD=becs_dev_password
POSTGRES_DB=becs_lims
# Prisma connection string (matches the values above)
DATABASE_URL="postgresql://becs:becs_dev_password@localhost:5432/becs_lims?schema=public"

# --- Auth.js ---
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-strong-random-secret"
AUTH_URL="http://localhost:3000"

# --- Object storage (MinIO / S3-compatible) ---
MINIO_ROOT_USER=becs_minio
MINIO_ROOT_PASSWORD=becs_minio_password
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID=becs_minio
S3_SECRET_ACCESS_KEY=becs_minio_password
S3_BUCKET="becs-lims"

# --- App ---
NODE_ENV=development
# Default facility-local timezone for display (data stored UTC)
APP_DEFAULT_TZ="Asia/Karachi"
