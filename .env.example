# BECS Analytics LIMS — environment template. Copy to `.env` and fill in.
# Never commit a real .env (see .gitignore).

# --- Database ---
# Local dev via docker-compose:
POSTGRES_USER=becs
POSTGRES_PASSWORD=becs_dev_password
POSTGRES_DB=becs_lims

# Application queries. In the cloud this is Supabase's *pooled* connection
# (Supavisor, port 6543) with ?pgbouncer=true&connection_limit=1 appended.
DATABASE_URL="postgresql://becs:becs_dev_password@localhost:5432/becs_lims?schema=public"
# Migrations only. Prisma cannot migrate through a transaction pooler, so this must
# be the *direct* connection (port 5432). REQUIRED even locally — Prisma fails
# validation if it is unset. Locally it is simply the same value as DATABASE_URL.
DIRECT_URL="postgresql://becs:becs_dev_password@localhost:5432/becs_lims?schema=public"

# --- Auth.js ---
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-strong-random-secret"
AUTH_URL="http://localhost:3000"
# Required when running behind a proxy (Render, any reverse proxy). Not needed locally.
# AUTH_TRUST_HOST=true

# --- Object storage (attachments) ---
# "local"    -> ./storage on disk. The default; fine for dev, NEVER for the cloud,
#               where the container filesystem is wiped on every restart.
# "supabase" -> Supabase Storage. Required for any cloud deployment.
STORAGE_DRIVER=local

# Only read when STORAGE_DRIVER=supabase:
# SUPABASE_URL="https://<project-ref>.supabase.co"
# Service-role key — bypasses row-level security. Server-side only; never expose it
# to the browser and never prefix it with NEXT_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY="..."
# SUPABASE_STORAGE_BUCKET="becs-lims"

# --- App ---
NODE_ENV=development
# Default facility-local timezone for display (data stored UTC)
APP_DEFAULT_TZ="Asia/Karachi"

# --- Admin bootstrap (prisma/create-admin.ts, via `npm run db:admin`) ---
# ADMIN_EMAIL="admin@becs.test"
# ADMIN_PASSWORD="change-me"
